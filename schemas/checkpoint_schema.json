{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckpointSchema",
  "type": "object",
  "properties": {
    "module": { "type": "integer" },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkpoint": { "type": "integer" },
          "after_level": { "type": "integer" },
          "covers_levels": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "questions": {
            "type": "array"
          }
        },
        "required": ["questions"],
        "additionalProperties": true
      }
    }
  },
  "required": ["module", "checkpoints"],
  "additionalProperties": true
}
