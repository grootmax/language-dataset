{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckpointSchema",
  "type": "object",
  "properties": {
    "module": { "type": "integer" },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkpoint": { "type": "integer" },
          "after_level": { "type": "integer" },
          "covers_levels": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "source_item_ids": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "type": { "type": "string" },
                "options": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "options_read_as": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "answer_index": { "type": "integer" }
              },
              "patternProperties": {
                "^prompt_[a-z]{2}$": { "type": "string" },
                "^explanation_[a-z]{2}$": { "type": "string" }
              },
              "required": ["id", "source_item_ids", "type", "options", "answer_index"]
            }
          }
        },
        "patternProperties": {
          "^title_[a-z]{2}$": { "type": "string" }
        },
        "required": ["checkpoint", "after_level", "covers_levels", "questions"]
      }
    }
  },
  "patternProperties": {
    "^module_name_[a-z]{2}$": { "type": "string" }
  },
  "required": ["module", "checkpoints"]
}
