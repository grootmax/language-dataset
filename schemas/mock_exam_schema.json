{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MockOrFinalExamSchema",
  "type": "object",
  "properties": {
    "module": { "type": "integer" },
    "kind": { "type": "string" },
    "mock_exam": {
      "type": "object",
      "properties": {
        "total_questions": { "type": "integer" },
        "questions": { "type": "array" }
      },
      "required": ["questions"]
    },
    "questions": { "type": "array" },
    "sections": { "type": "array" }
  },
  "anyOf": [
    {
      "required": ["module", "mock_exam"]
    },
    {
      "required": ["module", "questions"]
    },
    {
      "required": ["kind", "sections"]
    }
  ],
  "additionalProperties": true
}
