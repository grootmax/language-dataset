      "title_en": "How stacks work, the four special conjuncts, and common stacks",
      "questions": [
        {
          "id": "M03-CP2-Q1",
          "source_item_ids": [
            "M03-L06-I1"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'true, genuine'?",
          "options": [
            "सच्चा",
            "सच्च",
            "सचच",
            "सचचा"
          ],
          "answer_index": 0,
          "explanation_en": "Writing the two letters separately puts a vowel between them, which is not how the word is said — they must stack."
        },
        {
          "id": "M03-CP2-Q2",
          "source_item_ids": [
            "M03-L06-I2"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'action, deed'?",
          "options": [
            "क्रम",
            "कर्म",
            "करम",
            "क्रर्म"
          ],
          "answer_index": 1,
          "explanation_en": "Both क्रम and कर्म are real words — the position of र is the whole difference. क्रम means 'order, sequence'; कर्म means 'action, deed'."
        },
        {
          "id": "M03-CP2-Q3",
          "source_item_ids": [
            "M03-L06-I3"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'forgiveness'?",
          "options": [
            "कक्षमा",
            "कशमा",
            "क्षमा",
            "क्समा"
          ],
          "answer_index": 2,
          "explanation_en": "Writing the letters separately inserts a vowel between them, and also swaps in श where the word actually takes ष."
        },
        {
          "id": "M03-CP2-Q4",
          "source_item_ids": [
            "M03-L07-I1"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'friend'?",
          "options": [
            "मीत्र",
            "मीतर",
            "मितर",
            "मित्र"
          ],
          "answer_index": 3,
          "explanation_en": "Writing the letters separately puts a vowel between them; the conjunct runs त straight into र with no vowel."
        },
        {
          "id": "M03-CP2-Q5",
          "source_item_ids": [
            "M03-L07-I2"
          ],
          "type": "recognition",
          "prompt_en": "ज्ञान ('knowledge') uses which conjunct for its opening sound?",
          "options": [
            "श्र",
            "ज्ञ",
            "क्ष",
            "त्र"
          ],
          "answer_index": 1,
          "explanation_en": "This distinctive conjunct, pronounced roughly 'gy', opens ज्ञान."
        },
        {
          "id": "M03-CP2-Q6",
          "source_item_ids": [
            "M03-L07-I3"
          ],
          "type": "recognition",
          "prompt_en": "श्री (the honorific 'Mr') uses which conjunct?",
          "options": [
            "त्र",
            "ज्ञ",
            "श्र",
            "क्ष"
          ],
          "answer_index": 2,
          "explanation_en": "श्र stacks श directly onto र with no vowel between."
        },
        {
          "id": "M03-CP2-Q7",
          "source_item_ids": [
            "M03-L08-I2"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'pure, clean'?",
          "options": [
            "शुद",
            "शुध्द",
            "शुध",
            "शुद्ध"
          ],
          "answer_index": 3,
          "explanation_en": "Only one consonant looks written here, but two are pronounced — a plain द and then a breathy ध."
        },
        {
          "id": "M03-CP2-Q8",
          "source_item_ids": [
            "M03-L08-I3"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'grain, food'?",
          "options": [
            "अन्न",
            "अन्",
            "अणन",
            "अन"
          ],
          "answer_index": 0,
          "explanation_en": "A single न gives a short sound; the stack न्न holds it noticeably longer, and the two are different words."
        },
        {
          "id": "M03-CP2-Q9",
          "source_item_ids": [
            "M03-L09-I2"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'firm, certain; ripe'?",
          "options": [
            "पक्क",
            "पका",
            "पक्का",
            "पाका"
          ],
          "answer_index": 2,
          "explanation_en": "A single क gives पका, meaning 'cooked' or 'ripened'. The stack क्क holds the sound longer and means something else."
        },
        {
          "id": "M03-CP2-Q10",
          "source_item_ids": [
            "M03-L10-I2"
          ],
          "type": "recognition",
          "prompt_en": "उत्तर ('north; an answer') uses which conjunct?",
          "options": [
            "ज्ज",
            "प्प",
            "स्त",
            "त्त"
          ],
          "answer_index": 3,
          "explanation_en": "त्त stacks two त sounds together, held slightly longer than a single त."
        }
      ]
    }
  ]
}