      "title_en": "Matras on, below and above the line, plus the nasal marks",
      "questions": [
        {
          "id": "M03-CP1-Q1",
          "source_item_ids": [
            "M03-L01-I1"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'work'?",
          "options": [
            "काम",
            "कम",
            "कीम",
            "कोम"
          ],
          "answer_index": 0,
          "explanation_en": "Without the ा stroke the consonant keeps its inherent अ, and कम means 'less'."
        },
        {
          "id": "M03-CP1-Q2",
          "source_item_ids": [
            "M03-L01-I2"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling is correct for 'book'?",
          "options": [
            "केताब",
            "किताब",
            "कीताब",
            "कितीब"
          ],
          "answer_index": 1,
          "explanation_en": "The first vowel is short इ. The long ी attaches on the other side and gives a different syllable."
        },
        {
          "id": "M03-CP1-Q3",
          "source_item_ids": [
            "M03-L01-I3"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling is correct for 'water'?",
          "options": [
            "पानू",
            "पानि",
            "पानी",
            "पिनी"
          ],
          "answer_index": 2,
          "explanation_en": "Words ending in this vowel take the long ी; the short ि is very rare in final position."
        },
        {
          "id": "M03-CP1-Q4",
          "source_item_ids": [
            "M03-L02-I1"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'bad'?",
          "options": [
            "बरा",
            "बोरा",
            "बूरा",
            "बुरा"
          ],
          "answer_index": 3,
          "explanation_en": "One hook is short and the deeper one is long; this word takes the short hook ु."
        },
        {
          "id": "M03-CP1-Q5",
          "source_item_ids": [
            "M03-L02-I2"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'milk'?",
          "options": [
            "दुध",
            "दूध",
            "दध",
            "दोध"
          ],
          "answer_index": 1,
          "explanation_en": "The vowel is long; shortening it is the commonest slip English speakers make in this word."
        },
        {
          "id": "M03-CP1-Q6",
          "source_item_ids": [
            "M03-L02-I3"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'please'?",
          "options": [
            "कीरपया",
            "किरपया",
            "कृपया",
            "करपया"
          ],
          "answer_index": 2,
          "explanation_en": "The sound really is 'kri', but it's written with the single matra ृ rather than ि plus र."
        },
        {
          "id": "M03-CP1-Q7",
          "source_item_ids": [
            "M03-L03-I1"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'my'?",
          "options": [
            "मोरा",
            "मारा",
            "मैरा",
            "मेरा"
          ],
          "answer_index": 3,
          "explanation_en": "Two strokes give ऐ, a more open vowel, and the word is no longer 'my'."
        },
        {
          "id": "M03-CP1-Q8",
          "source_item_ids": [
            "M03-L03-I2"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'money'?",
          "options": [
            "पैसा",
            "पोसा",
            "पासा",
            "पेसा"
          ],
          "answer_index": 0,
          "explanation_en": "A single stroke े gives the narrower ए; this word needs the wider vowel ै."
        },
        {
          "id": "M03-CP1-Q9",
          "source_item_ids": [
            "M03-L04-I1"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'who'?",
          "options": [
            "कीन",
            "कोन",
            "कौन",
            "कान"
          ],
          "answer_index": 2,
          "explanation_en": "One mark above gives the narrower ो; this word needs the two-stroke ौ."
        },
        {
          "id": "M03-CP1-Q10",
          "source_item_ids": [
            "M03-L05-I3"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling is correct for 'Hindi, the language'?",
          "options": [
            "हिन्दी",
            "हींदी",
            "हिँदी",
            "हिंदी"
          ],
          "answer_index": 3,
          "explanation_en": "A real n is pronounced before द here, so this word takes the plain dot ं rather than the nose-only crescent ँ."
        }
      ]
    },
    {
      "checkpoint": 2,
