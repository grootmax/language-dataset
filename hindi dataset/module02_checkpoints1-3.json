      ],
      "title_en": "य र ल, the sh-letters, and the dotted borrowings",
      "questions": [
        {
          "id": "M02-CP3-Q1",
          "source_item_ids": [
            "M02-L11-I1"
          ],
          "type": "recognition",
          "prompt_en": "याद ('memory') begins with which letter?",
          "options": [
            "य",
            "र",
            "ल",
            "व"
          ],
          "answer_index": 0,
          "explanation_en": "याद opens with the semivowel य."
        },
        {
          "id": "M02-CP3-Q2",
          "source_item_ids": [
            "M02-L11-I2"
          ],
          "type": "recognition",
          "prompt_en": "रात ('night') begins with which letter?",
          "options": [
            "व",
            "र",
            "य",
            "ल"
          ],
          "answer_index": 1,
          "explanation_en": "रात opens with र."
        },
        {
          "id": "M02-CP3-Q3",
          "source_item_ids": [
            "M02-L11-I3"
          ],
          "type": "recognition",
          "prompt_en": "लाल ('red') begins with which letter?",
          "options": [
            "य",
            "व",
            "ल",
            "र"
          ],
          "answer_index": 2,
          "explanation_en": "लाल opens with ल."
        },
        {
          "id": "M02-CP3-Q4",
          "source_item_ids": [
            "M02-L12-I1"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'back' (as in 'go back')?",
          "options": [
            "वापिस",
            "बापिस",
            "बापस",
            "वापस"
          ],
          "answer_index": 3,
          "explanation_en": "व keeps the lips apart. Closing them fully turns it into ब, giving a non-word."
        },
        {
          "id": "M02-CP3-Q5",
          "source_item_ids": [
            "M02-L12-I2"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'city'?",
          "options": [
            "सहर",
            "शहर",
            "षहर",
            "सहार"
          ],
          "answer_index": 1,
          "explanation_en": "स and श are different sounds. 'City' specifically takes श, not स."
        },
        {
          "id": "M02-CP3-Q6",
          "source_item_ids": [
            "M02-L12-I3"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling means 'language'?",
          "options": [
            "भाश",
            "भाशा",
            "भाषा",
            "भासा"
          ],
          "answer_index": 2,
          "explanation_en": "श and ष sound identical in modern speech; only the word's origin tells you which to write. 'Language' takes ष."
        },
        {
          "id": "M02-CP3-Q7",
          "source_item_ids": [
            "M02-L13-I3"
          ],
          "type": "recognition",
          "prompt_en": "Which is the standard spelling for 'certainly, of course'?",
          "options": [
            "जरुर",
            "ज़रुर",
            "जरूर",
            "ज़रूर"
          ],
          "answer_index": 3,
          "explanation_en": "Without the dot the letter is read as j. Dropping it is common informally, but the dotted ज़ is the standard spelling."
        },
        {
          "id": "M02-CP3-Q8",
          "source_item_ids": [
            "M02-L14-I1"
          ],
          "type": "recognition",
          "prompt_en": "क़रीब ('near, close') uses which letter for its opening sound?",
          "options": [
            "क़",
            "क",
            "ख़",
            "ख"
          ],
          "answer_index": 0,
          "explanation_en": "This borrowed Persian/Arabic sound is written with the dotted क़, distinct from plain क."
        },
        {
          "id": "M02-CP3-Q9",
          "source_item_ids": [
            "M02-L15-I2"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling is correct for 'boy'?",
          "options": [
            "लड्का",
            "लडका",
            "लड़का",
            "लढका"
          ],
          "answer_index": 2,
          "explanation_en": "Without the dot, the letter is the stop ड, which holds the air instead of flicking past it. The dot is not optional here."
        },
        {
          "id": "M02-CP3-Q10",
          "source_item_ids": [
            "M02-L15-I3"
          ],
          "type": "recognition",
          "prompt_en": "Which spelling is correct for 'to read, to study'?",
          "options": [
            "पड़ना",
            "पडना",
            "पढना",
            "पढ़ना"
          ],
          "answer_index": 3,
          "explanation_en": "Without the dot the letter is the stop ढ, which holds the air. The undotted spelling is common informally, but the two are different sounds."
        }
      ]
    }
  ]
}